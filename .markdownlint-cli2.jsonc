{
  "config": {
    // Long paragraphs and tables in the research notes
    "MD013": false,
    // Bold lines instead of headings are intended in the notes
    "MD036": false,
    // Centered README header and keyboard keys
    "MD033": { "allowed_elements": ["div", "kbd"] },
    // Notes do not always start with an H1 (front matter, ### as opener)
    "MD041": false
  }
}
